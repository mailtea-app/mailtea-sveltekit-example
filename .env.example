# Create a key at https://studio.mailtea.app/api-keys
MAILTEA_API_KEY=mt_pat_your_api_key

# A sender on a domain you have verified in Mailtea.
MAILTEA_FROM="Acme <hello@acme.com>"

# Where contact form submissions are delivered.
MAILTEA_TO=you@acme.com

# Optional. Overrides the API host, which defaults to https://api.mailtea.app.
# MAILTEA_API_BASE_URL=https://api.mailtea.app
